rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size() < 900000
        && request.resource.data.keys().hasOnly(["version", "categories", "recipes", "updatedAt"])
        && request.resource.data.version == 1
        && request.resource.data.categories is list
        && request.resource.data.recipes is list
        && request.resource.data.categories.size() < 80
        && request.resource.data.recipes.size() < 400
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
  }
}
